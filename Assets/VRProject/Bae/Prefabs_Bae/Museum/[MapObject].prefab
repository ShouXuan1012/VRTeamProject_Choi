    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "[\uC7A5\uC778\uC758 \uC791\uC5C5\uB300, \uBAA8\uB8E8]\n\n\uBAA8\uB8E8\uB294
    \uAE08\uC18D\uC744 \uB450\uB4DC\uB9AC\uACE0, \uD615\uC744 \uB9CC\uB4E4\uBA70,
    \uBB34\uAE30\uC640 \uB3C4\uAD6C\uB97C \uD0C4\uC0DD\uC2DC\uD0A8 \uC81C\uC791\uC758
    \uC911\uC2EC\uC785\uB2C8\uB2E4.\n\uBAA8\uB4E0 \uCE7C\uACFC \uAC11\uC637, \uC1E0\uB9DD\uCE58\uC640
    \uB3C4\uB07C\uB294 \uC774 \uB2E8\uB2E8\uD55C \uBC1B\uCE68\uB300 \uC704\uC5D0\uC11C
    \uD0DC\uC5B4\uB0AC\uC2B5\uB2C8\uB2E4.\n\uAC89\uBCF4\uAE30\uC5D4 \uB2E8\uC21C\uD558\uC9C0\uB9CC,
    \uC218\uB9CE\uC740 \uBD88\uAF43\uACFC \uB540\uC744 \uBC84\uD168\uB0B8 \n\uC81C\uC791\uC758
    \uC0C1\uC9D5\uC785\uB2C8\uB2E4."
